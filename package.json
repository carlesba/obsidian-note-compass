{
	"name": "obsidian-note-compass",
	"version": "0.11.0",
	"description": "Jump to notes related to the note in focus or in lists you define, set its properties from one picker, and create notes from forms you define.",
	"main": "main.js",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"lint": "eslint src",
		"test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/*.test.ts"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"navigation"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/carlesba/obsidian-note-compass.git"
	},
	"homepage": "https://github.com/carlesba/obsidian-note-compass",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.30",
		"esbuild": "^0.20.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"moment": "^2.29.4",
		"obsidian": "latest",
		"tslib": "^2.6.2",
		"typescript": "^5.4.5"
	}
}
