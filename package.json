{
	"name": "obsidian-note-launcher",
	"version": "0.1.0",
	"description": "Opens a picker of the notes linked to and from the note in focus, its adjacent date notes, notes from the same day and lists you define by frontmatter, from anywhere in the app.",
	"main": "main.js",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"lint": "eslint src",
		"test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/*.test.ts"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"navigation"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/carlesba/obsidian-note-launcher.git"
	},
	"homepage": "https://github.com/carlesba/obsidian-note-launcher",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.30",
		"esbuild": "^0.20.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "latest",
		"tslib": "^2.6.2",
		"typescript": "^5.4.5"
	}
}
